# Large upstream dumps — reproducible via scripts/fetch_*.py, never edited by hand.
# Small derived extracts under data/derived/ ARE committed; the bulky intermediates
# below are regenerated by scripts/parse_dblp.py from the dump.
# ** is required: a single * does not cross directory levels, so the dated
# subdirectory slipped through and a 1 GB dump landed in the first commit.
data/raw/dblp/**/*.xml
data/raw/dblp/**/*.xml.gz
data/raw/dblp/**/*.dtd
data/raw/grid/**
data/raw/openalex/**
data/derived/dblp_persons.csv.gz
data/derived/dblp_venue_authorships.csv.gz
data/raw/openalex/*.jsonl
data/raw/grid/*.zip
data/raw/grid/*.tif
data/raw/grid/*.gpkg

__pycache__/
*.pyc
.venv/
.DS_Store

# venv and derived grids (regenerate with scripts/build_*_grid.py)
.venv/
data/derived/*.npz
data/raw/grid/

# The assembled single-file page is regenerated by scripts/build_site.py
site/index.html
site/payload.js

# Decision ledger is append-only; regenerate only by deleting it deliberately.
!data/decisions.jsonl
