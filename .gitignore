# Large upstream dumps — reproducible via scripts/fetch_*.py, never edited by hand.
# Small derived extracts under data/derived/ ARE committed; the bulky intermediates
# below are regenerated by scripts/parse_dblp.py from the dump.
data/raw/dblp/*.xml
data/raw/dblp/*.xml.gz
data/raw/dblp/*.dtd
data/derived/dblp_persons.csv.gz
data/derived/dblp_venue_authorships.csv.gz
data/raw/openalex/*.jsonl
data/raw/grid/*.zip
data/raw/grid/*.tif
data/raw/grid/*.gpkg

__pycache__/
*.pyc
.venv/
.DS_Store
